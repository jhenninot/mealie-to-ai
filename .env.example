# URL de votre instance Mealie, telle que le conteneur du connecteur peut la joindre
MEALIE_URL=http://mealie:9000

# Jeton API Mealie : Profil utilisateur > Jetons API > Générer
MEALIE_API_TOKEN=

# Secret protégeant le connecteur (au moins 24 caractères).
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Optionnel
# PORT=8000
# MEALIE_TIMEOUT=30
